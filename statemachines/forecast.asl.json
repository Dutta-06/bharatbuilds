{
  "Comment": "pravaah-forecast: every hour, for each region fetch 48 h of weather + grid, (predict), store. One failing region does not stop the others.",
  "StartAt": "HasRegions",
  "States": {
    "HasRegions": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.regions", "IsPresent": true, "Next": "ForEachRegion"}],
      "Default": "DefaultRegions"
    },
    "DefaultRegions": {
      "Type": "Pass",
      "Result": ${RegionList},
      "ResultPath": "$.regions",
      "Next": "ForEachRegion"
    },
    "ForEachRegion": {
      "Type": "Map",
      "ItemsPath": "$.regions",
      "MaxConcurrency": 4,
      "Parameters": {
        "region.$": "$$.Map.Item.Value",
        "run_id.$": "$$.Execution.StartTime"
      },
      "Iterator": {
        "StartAt": "Fetch",
        "States": {
          "Fetch": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {"FunctionName": "${FetchForecastArn}", "Payload": {"region.$": "$.region"}},
            "ResultSelector": {"rows.$": "$.Payload.rows", "raw_key.$": "$.Payload.raw_key"},
            "ResultPath": "$.fetched",
            "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0}],
            "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RegionFailed"}],
            "Next": "Predict"
          },
          "Predict": {
            "Type": "Task",
            "Comment": "Step 4 models. A model only changes values if it beat persistence and the provider on held-out days; otherwise rows pass through. Any error falls back to the provider rows.",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {"FunctionName": "${PredictArn}", "Payload": {"region.$": "$.region", "rows.$": "$.fetched.rows"}},
            "ResultSelector": {"rows.$": "$.Payload.rows"},
            "ResultPath": "$.fetched",
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 2}],
            "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.predict_error", "Next": "Store"}],
            "Next": "Store"
          },
          "Store": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StoreForecastArn}",
              "Payload": {"region.$": "$.region", "rows.$": "$.fetched.rows", "run_id.$": "$.run_id"}
            },
            "OutputPath": "$.Payload",
            "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0}],
            "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RegionFailed"}],
            "End": true
          },
          "RegionFailed": {
            "Type": "Pass",
            "Parameters": {"region.$": "$.region", "failed": true, "error.$": "$.error"},
            "End": true
          }
        }
      },
      "ResultPath": "$.results",
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "PublishSurface"
    },
    "PublishSurface": {
      "Type": "Task",
      "Comment": "Static copies of the default /surface grids on S3 so bursts never reach Lambda. A failure here fails the run (and raises the pipeline alarm).",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${PublishSurfaceArn}", "Payload": {}},
      "ResultPath": "$.published",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 2, "BackoffRate": 2.0}],
      "Next": "NudgeWaitingJobs"
    },
    "NudgeWaitingJobs": {
      "Type": "Task",
      "Comment": "Email once when a much better window opened for a job still waiting to start. A failure here must not fail the forecast run.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${NudgeArn}", "Payload": {}},
      "ResultPath": "$.nudged",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 5, "MaxAttempts": 2, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.nudge_error", "Next": "Done"}],
      "Next": "Done"
    },
    "Done": {"Type": "Succeed"},
    "PipelineFailed": {"Type": "Fail", "Error": "PipelineFailed", "Cause": "The region map failed; see the execution history and CloudWatch Logs."}
  }
}
