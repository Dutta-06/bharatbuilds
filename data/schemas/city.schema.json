{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "City grid",
  "type": "object",
  "required": ["id", "name", "name_hi", "timezone", "bounds", "ref_elevation_m", "cells"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "name_hi": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "pattern": "^[A-Za-z_]+/[A-Za-z_]+$"},
    "_note": {"type": "string"},
    "bounds": {
      "type": "object",
      "required": ["south", "west", "north", "east"],
      "properties": {
        "south": {"type": "number", "minimum": -90, "maximum": 90},
        "north": {"type": "number", "minimum": -90, "maximum": 90},
        "west": {"type": "number", "minimum": -180, "maximum": 180},
        "east": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    },
    "ref_elevation_m": {"type": ["number", "null"]},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "name_hi", "lat", "lon", "elevation_m"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "name_hi": {"type": "string", "minLength": 1},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": -180, "maximum": 180},
          "elevation_m": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
