{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relief points (water, shade, shelter) for one city",
  "type": "object",
  "required": ["city", "points"],
  "properties": {
    "city": {"type": "string"},
    "_note": {"type": "string"},
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "name_hi", "type", "lat", "lon", "cell_id", "amenities", "source", "verified"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string"},
          "name_hi": {"type": "string"},
          "type": {"enum": ["piyao", "park", "shelter", "religious", "cooling-centre", "metro", "other"]},
          "lat": {"type": "number"},
          "lon": {"type": "number"},
          "cell_id": {"type": ["string", "null"]},
          "amenities": {"type": "array", "minItems": 1, "uniqueItems": true,
                        "items": {"enum": ["water", "shade", "food", "toilet", "cooling", "first-aid"]}},
          "source": {"type": "string"},
          "verified": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
