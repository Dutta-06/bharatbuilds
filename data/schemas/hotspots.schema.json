{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Waterlogging hotspots for one city",
  "type": "object",
  "required": ["city", "sources", "hotspots"],
  "properties": {
    "city": {"type": "string"},
    "_note": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "publisher", "title", "url"],
        "properties": {
          "id": {"type": "string"},
          "publisher": {"type": "string"},
          "title": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "date": {"type": "string", "format": "date"}
        },
        "additionalProperties": false
      }
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "name_hi", "kind", "lat", "lon", "cell_id", "perennial", "sources", "verified"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string"},
          "name_hi": {"type": "string"},
          "kind": {"enum": ["underpass", "road", "junction", "stretch", "colony"]},
          "lat": {"type": "number"},
          "lon": {"type": "number"},
          "cell_id": {"type": ["string", "null"]},
          "perennial": {"type": "boolean"},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "verified": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
